{
  "name": "avcallbutton",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "services/*"
    ],
    "nohoist": [
      "**/@av/ui",
      "**/@av/ui/**"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-types": "turbo run check-types",

    "ios": "yarn --cwd apps/mobile ios",
    "ios:start": "yarn --cwd apps/mobile ios:start",
    "android": "yarn --cwd apps/mobile android",
    "android:start": "yarn --cwd apps/mobile android:start",

    "web": "yarn --cwd apps/web dev",
    "web:build": "yarn --cwd apps/web build",
    "web:start": "yarn --cwd apps/web start",
    "web:dev:env": "yarn --cwd apps/web dev:env",

    "backend:dev": "yarn --cwd services/backend dev",
    "backend:deploy": "yarn --cwd services/backend deploy",
    "backend:deploy:prod": "yarn --cwd services/backend deploy:prod",

    "setup": "bash scripts/setup.sh",
    "setup:nuke": "bash scripts/setup.sh --nuke",

    "prisma:migrate": "yarn --cwd services/backend prisma:migrate",
    "prisma:generate": "yarn --cwd services/backend prisma:generate",
    "db:nuke": "yarn --cwd services/backend db:nuke"
  },
  "dependencies": {
    "@chakra-ui/next-js": "^2.4.2",
    "@chakra-ui/react": "^3.29.0",
    "@chakra-ui/styled-system": "^2.12.0",
    "@chakra-ui/theme-tools": "^2.2.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/hooks": "^100.1.0",
    "axios": "^1.13.2",
    "expo": "~54.0.25",
    "framer-motion": "^12.23.24",
    "native-base": "^3.4.28",
    "react": "19.1.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-native": "0.81.5",
    "react-native-worklets": "0.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.2",
    "prettier": "^3.1.1",
    "sucrase": "^3.35.1",
    "turbo": "^2.6.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "zod": "3.25.76",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "version": "1.0.0"
}
